/*
========================================================================================
    Minimal ChIP-seq test: public nf-core yeast SPT5 data (100k read pairs per FASTQ).
    Two cases share one Input (each library split over lanes), plus a single-end
    case without a control; ROSE runs on SPT5.
        nextflow run zcmit/peddep-nf -profile test_chip,docker --outdir results
    Add --assay cutrun to exercise the CUT&RUN duplicate handling on the same data.
========================================================================================
*/

params {
    config_profile_name        = 'ChIP-seq test profile'
    config_profile_description = 'Minimal yeast ChIP-seq dataset to check pipeline function'

    assay      = 'chip'
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    input      = "${projectDir}/assets/samplesheet_test_chip.csv"

    fasta      = 'https://raw.githubusercontent.com/nf-core/test-datasets/chipseq/reference/genome.fa'
    gtf        = 'https://raw.githubusercontent.com/nf-core/test-datasets/chipseq/reference/genes.gtf'
    mito_name  = 'MT'
    macs_gsize = '1.2e7'

    rose_marks       = 'SPT5'
    fingerprint_bins = 1000
    tss_window       = 1000
    qc_thresholds    = "${projectDir}/assets/chip_qc_thresholds_test.json"
}

process {
    resourceLimits = [
        cpus  : 2,
        memory: '6.GB',
        time  : '6.h'
    ]
}
