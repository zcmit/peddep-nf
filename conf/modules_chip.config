/*
========================================================================================
    ChIP-seq / CUT&RUN (--assay chip | cutrun): tool arguments and output locations.

    Every library (cases and Input/IgG controls) gets its own folder: the samplesheet's
    `outdir` column when set, otherwise <--outdir>/<sample>. Run-level results go to
    <--outdir>.
========================================================================================
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        enabled: false
    ]

    // ---------------------------------------------------------------- reference
    withName: 'GUNZIP_.*|SAMTOOLS_FAIDX|BOWTIE2_BUILD|GENOME_FILTER|GTF2TSS|GENOME_SIZE|GTF2ROSE' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    // ---------------------------------------------------------------- per lane
    withName: 'FASTQC_RAW' {
        ext.prefix = { "${meta.id}_L${meta.lane}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/FastQC/raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TRIMGALORE' {
        // adapter auto-detected (TruSeq/Nextera/small RNA) unless --adapter is given
        ext.prefix = { "${meta.id}_L${meta.lane}" }
        ext.args   = {
            [
                "--length ${params.min_trim_length}",
                params.adapter ? "--adapter ${params.adapter}" + (meta.single_end ? '' : " --adapter2 ${params.adapter}") : '',
                '--fastqc'
            ].join(' ').trim()
        }
        publishDir = [
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/trim_report" },
                mode: params.publish_dir_mode,
                pattern: '*_trimming_report.txt'
            ],
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/FastQC/trimmed" },
                mode: params.publish_dir_mode,
                pattern: '*_fastqc.{zip,html}'
            ],
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/trimmed_fastq" },
                mode: params.publish_dir_mode,
                pattern: '*.fq.gz',
                enabled: params.save_trimmed
            ]
        ]
    }

    withName: 'BOWTIE2_ALIGN' {
        ext.prefix = { "${meta.id}_L${meta.lane}" }
        ext.args   = {
            meta.single_end ?
                '--very-sensitive' :
                "--very-sensitive --no-mixed --no-discordant -X ${params.max_fragment_length}"
        }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.bowtie2.log'
        ]
    }

    // ---------------------------------------------------------------- per library
    withName: 'PICARD_MARKDUPLICATES' {
        publishDir = [
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/duplicates" },
                mode: params.publish_dir_mode,
                pattern: '*.metrics.txt'
            ],
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/BAM_files" },
                mode: params.publish_dir_mode,
                pattern: '*.markdup.bam*',
                enabled: params.save_markdup_bam
            ]
        ]
    }

    withName: 'SAMTOOLS_STATS_MARKDUP' {
        ext.prefix = { "${meta.id}.markdup" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_STATS_FILTERED' {
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LIBRARY_COMPLEXITY' {
        ext.args   = { "--min-mapq ${params.min_mapq}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/library_complexity" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BAM_FILTER' {
        // 2828 = unmapped, mate unmapped, secondary, QC-fail, supplementary; +1024 = duplicates
        ext.args   = { "${meta.single_end ? '' : '-f 2 '}-F ${meta.dedup ? 3852 : 2828} -q ${params.min_mapq}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/BAM_files" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PHANTOMPEAKQUALTOOLS' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/phantompeakqualtools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BIGWIG_COVERAGE' {
        // one count per fragment: read 1 extended to its mate (PE) or by --se_fragment_length (SE)
        ext.prefix = { "${meta.id}.fragments.CPM" }
        ext.args   = {
            meta.single_end ?
                "--normalizeUsing CPM --binSize 10 --extendReads ${params.se_fragment_length}" :
                '--normalizeUsing CPM --binSize 10 --extendReads --samFlagInclude 64'
        }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/COVERAGE_files" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ---------------------------------------------------------------- per case (vs its control)
    withName: 'MACS3_NARROW' {
        ext.args   = {
            "--qvalue ${params.macs_qvalue ?: 0.05} --call-summits" +
                (meta.single_end ? " --nomodel --extsize ${params.se_fragment_length}" : '')
        }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS/NARROW_peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MACS3_BROAD' {
        ext.args   = {
            "--qvalue ${params.macs_qvalue ?: 0.05} --broad --broad-cutoff ${params.macs_broad_cutoff}" +
                (meta.single_end ? " --nomodel --extsize ${params.se_fragment_length}" : '')
        }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS/BROAD_peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BROWSER_PEAKS_NARROW' {
        ext.prefix = { "${meta.id}_narrow_peaks" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS/NARROW_peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BROWSER_PEAKS_BROAD' {
        ext.prefix = { "${meta.id}_broad_peaks" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS/BROAD_peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BIGWIG_VS_CONTROL' {
        // pyflow-ChIPseq style input-subtracted track, CPM-normalised
        ext.prefix = { "${meta.id}.minus_control.CPM" }
        ext.args   = {
            '--operation subtract --normalizeUsing CPM --scaleFactorsMethod None --binSize 50 ' +
                (meta.single_end ? "--extendReads ${params.se_fragment_length}" : '--extendReads --samFlagInclude 64')
        }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/COVERAGE_files" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPTOOLS_FINGERPRINT' {
        ext.args   = {
            "--numberOfSamples ${params.fingerprint_bins} " +
                (meta.single_end ? "--extendReads ${params.se_fragment_length}" : '--extendReads')
        }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/fingerprint" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPTOOLS_TSS_PLOTS' {
        ext.args   = { "--beforeRegionStartLength ${params.tss_window} --afterRegionStartLength ${params.tss_window} --binSize 10" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/TSS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FRIP' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ROSE' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHIP_QC_REPORT' {
        ext.args   = { params.assay == 'cutrun' ? "--assay-title 'CUT&RUN'" : "--assay-title 'ChIP-seq'" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ---------------------------------------------------------------- per run
    withName: 'CHIP_QC_SUMMARY' {
        ext.prefix = { "${params.assay}_qc_summary" }
        ext.args   = {
            params.assay == 'cutrun' ?
                "--title 'CUT&RUN' --section-id peddep_cutrun_grades --thresholds-name cutrun_qc_thresholds.json" :
                "--title 'ChIP-seq' --section-id peddep_chip_grades --thresholds-name chip_qc_thresholds.json"
        }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('_mqc.html')) ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
