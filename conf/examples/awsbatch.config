/*
 * AWS Batch. Inputs, references and outdir may all be s3:// paths.
 *     nextflow run zcmit/peddep-nf -c awsbatch.config --input s3://bucket/samplesheet.csv \
 *         --outdir s3://bucket/results --genome GRCh38 -work-dir s3://bucket/work
 * Needs a Batch compute environment + job queue. Fusion (with Wave) avoids installing
 * the AWS CLI in the compute AMI.
 */
process {
    executor = 'awsbatch'
    queue    = 'my-batch-queue'
}
aws {
    region = 'us-east-1'
}
wave.enabled   = true
fusion.enabled = true
