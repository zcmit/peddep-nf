/*
 * Template for a site config kept OUTSIDE this repository (it holds local paths).
 * Copy it, fill in the blanks and pass it with -c:
 *     nextflow run zcmit/peddep-nf -profile singularity -c my_site.config --input ... --outdir ...
 * If your institution has an nf-core profile (https://nf-co.re/configs) use
 * -profile <institution> for the scheduler and keep only the references here.
 */

// Local copies of the reference files: avoids re-downloading and rebuilding the bowtie2 index
params {
    genome           = null
    fasta            = '/path/to/genome.fa'
    gtf              = '/path/to/genes.gtf'
    blacklist        = '/path/to/blacklist.bed'          // optional
    bowtie2_index    = '/path/to/bowtie2/genome'         // prefix of genome.1.bt2 ..., or the directory
    mito_name        = 'chrM'
    macs_gsize       = '2.7e9'
    canonical_chroms = '^chr([0-9]+|X|Y|M)$'
}

// Scheduler (skip if an nf-core institutional profile already sets it)
process {
    executor = 'slurm'          // lsf | slurm | sge | pbspro | local ...
    queue    = 'normal'
    // Cap single tasks at what your nodes offer
    resourceLimits = [cpus: 32, memory: '256.GB', time: '72.h']
}

// Shared cache so images are downloaded once
singularity.cacheDir = '/shared/path/singularity_cache'
