/*
 * Generic SLURM cluster.
 *     nextflow run zcmit/peddep-nf -profile singularity -c slurm.config --input ... --outdir ...
 */
process {
    executor       = 'slurm'
    queue          = 'normal'                  // your partition
    // clusterOptions = '--account=my_account' // if your site requires one
    resourceLimits = [cpus: 32, memory: '256.GB', time: '72.h']
}
executor {
    queueSize       = 100
    submitRateLimit = '10/1sec'
}
singularity.cacheDir = '/shared/path/singularity_cache'
