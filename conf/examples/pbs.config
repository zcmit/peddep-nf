/*
 * PBS Pro / OpenPBS cluster (use executor 'pbs' for Torque).
 *     nextflow run zcmit/peddep-nf -profile singularity -c pbs.config --input ... --outdir ...
 */
process {
    executor       = 'pbspro'
    queue          = 'workq'
    resourceLimits = [cpus: 32, memory: '256.GB', time: '72.h']
}
executor {
    queueSize = 100
}
singularity.cacheDir = '/shared/path/singularity_cache'
