/*
 * Azure Batch. Inputs, references and outdir may be az:// paths.
 *     nextflow run zcmit/peddep-nf -c azurebatch.config --input az://container/samplesheet.csv \
 *         --outdir az://container/results --genome GRCh38 -work-dir az://container/work
 * Prefer managed identities or environment variables over keys in files.
 */
process {
    executor = 'azurebatch'
}
azure {
    storage {
        accountName = 'mystorageaccount'
    }
    batch {
        location                = 'eastus'
        accountName             = 'mybatchaccount'
        autoPoolMode            = true
        allowPoolCreation       = true
        deletePoolsOnCompletion = true
    }
}
