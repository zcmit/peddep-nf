/*
 * Google Cloud Batch. Inputs, references and outdir may be gs:// paths.
 *     nextflow run zcmit/peddep-nf -c google_batch.config --input gs://bucket/samplesheet.csv \
 *         --outdir gs://bucket/results --genome GRCh38 -work-dir gs://bucket/work
 */
process {
    executor = 'google-batch'
}
google {
    project    = 'my-gcp-project'
    location   = 'us-central1'
    batch.spot = true
}
wave.enabled   = true
fusion.enabled = true
