/*
 * Generic SGE / Univa / Son of Grid Engine cluster.
 *     nextflow run zcmit/peddep-nf -profile singularity -c sge.config --input ... --outdir ...
 */
process {
    executor       = 'sge'
    queue          = 'all.q'
    penv           = 'smp'                     // parallel environment for multi-core tasks
    clusterOptions = { "-l h_vmem=${(task.memory.toGiga() / task.cpus).intValue() + 1}G" }
    resourceLimits = [cpus: 16, memory: '128.GB', time: '72.h']
}
executor {
    queueSize = 100
}
singularity.cacheDir = '/shared/path/singularity_cache'
