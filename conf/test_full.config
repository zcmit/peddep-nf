/*
========================================================================================
    Full-size test: public human GM12878 ATAC-seq (ENCODE) on GRCh38.
    Builds the bowtie2 index from the GENCODE FASTA on first use, so it needs
    a machine or cluster with ~16 CPUs / 64 GB and several hours.
        nextflow run zcmit/peddep-nf -profile test_full,<engine>[,<site>] --outdir results
========================================================================================
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size human ATAC-seq dataset (GM12878, GRCh38)'

    input  = "${projectDir}/assets/samplesheet_test_full.csv"
    genome = 'GRCh38'
    save_reference = true
}

// FASTQs live in the public ngi-igenomes S3 bucket
aws.client.anonymous = true
