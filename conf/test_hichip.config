/*
========================================================================================
    Minimal HiChIP test: public nf-core HiCAR reads on human chr22 (test-datasets,
    hicar branch). One target split over two lanes with an INPUT control, plus a
    target without a control that brings its own anchors (`peaks` column).
        nextflow run zcmit/peddep-nf -profile test_hichip,docker --outdir results
    The reads are HiCAR, not HiChIP, so peaks and loops are few; the profile checks
    that every step runs.
========================================================================================
*/

params {
    config_profile_name        = 'HiChIP test profile'
    config_profile_description = 'Minimal human chr22 proximity-ligation dataset to check pipeline function'

    assay      = 'hichip'
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    input      = "${projectDir}/assets/samplesheet_test_hichip.csv"

    fasta      = 'https://raw.githubusercontent.com/nf-core/test-datasets/hicar/data/genomics/homo_sapiens/fasta/chr22.fa.gz'
    blacklist  = 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/master/lists/hg38-blacklist.v2.bed.gz'
    macs_gsize = '3.5e7'

    split_fastq     = 200000
    read_length     = 100
    qc_thresholds   = "${projectDir}/assets/hichip_qc_thresholds_test.json"
}

process {
    resourceLimits = [
        cpus  : 2,
        memory: '6.GB',
        time  : '6.h'
    ]
}
