/*
========================================================================================
    Public reference genomes, selected with --genome <key>.
    Every value can be overridden on the command line (--fasta, --gtf, --blacklist,
    --bowtie2_index, ...) or in a site config. Remote files are downloaded by Nextflow;
    a bowtie2 index is built on first use (add --save_reference to keep it).
========================================================================================
*/

params {
    genomes = [
        'GRCh38': [
            fasta           : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_38/GRCh38.primary_assembly.genome.fa.gz',
            gtf             : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_38/gencode.v38.primary_assembly.annotation.gtf.gz',
            blacklist       : 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/master/lists/hg38-blacklist.v2.bed.gz',
            mito_name       : 'chrM',
            macs_gsize      : '2.7e9',
            canonical_chroms: '^chr([0-9]+|X|Y|M)$'
        ],
        'hg38': [
            fasta           : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_38/GRCh38.primary_assembly.genome.fa.gz',
            gtf             : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_38/gencode.v38.primary_assembly.annotation.gtf.gz',
            blacklist       : 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/master/lists/hg38-blacklist.v2.bed.gz',
            mito_name       : 'chrM',
            macs_gsize      : '2.7e9',
            canonical_chroms: '^chr([0-9]+|X|Y|M)$'
        ],
        'GRCm38': [
            fasta           : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M25/GRCm38.primary_assembly.genome.fa.gz',
            gtf             : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M25/gencode.vM25.primary_assembly.annotation.gtf.gz',
            blacklist       : 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/master/lists/mm10-blacklist.v2.bed.gz',
            mito_name       : 'chrM',
            macs_gsize      : '1.87e9',
            canonical_chroms: '^chr([0-9]+|X|Y|M)$'
        ],
        'mm10': [
            fasta           : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M25/GRCm38.primary_assembly.genome.fa.gz',
            gtf             : 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_M25/gencode.vM25.primary_assembly.annotation.gtf.gz',
            blacklist       : 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/master/lists/mm10-blacklist.v2.bed.gz',
            mito_name       : 'chrM',
            macs_gsize      : '1.87e9',
            canonical_chroms: '^chr([0-9]+|X|Y|M)$'
        ]
    ]
}
