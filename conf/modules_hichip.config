/*
========================================================================================
    HiChIP (--assay hichip): tool arguments and output locations.

    Every library (targets and INPUT controls) gets its own folder: the samplesheet's
    `outdir` column when set, otherwise <--outdir>/<sample>. Run-level results go to
    <--outdir>.
========================================================================================
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        enabled: false
    ]

    // ---------------------------------------------------------------- reference
    withName: 'GUNZIP_.*|SAMTOOLS_FAIDX|BWAMEM2_INDEX|GENOME_FILTER|CHROM_SIZES|GENOME_SIZE' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    // ---------------------------------------------------------------- per lane / chunk
    withName: 'FASTQC_RAW' {
        ext.prefix = { "${meta.id}_L${meta.lane}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/FastQC/raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BWAMEM2_MEM' {
        // 5'-most piece of a chimeric read is primary (-5), mates aligned on their own (-SP),
        // all alignments reported for pairtools (-T0)
        ext.args = '-5SP -T0'
    }

    withName: 'PAIRTOOLS_PARSE' {
        ext.args = { "--min-mapq ${params.min_mapq} --walks-policy 5unique --max-inter-align-gap 30" }
    }

    // ---------------------------------------------------------------- per library
    withName: 'PAIRTOOLS_DEDUP' {
        publishDir = [
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/CONTACTS" },
                mode: params.publish_dir_mode,
                pattern: '*.pairs.gz',
                enabled: params.save_pairs
            ],
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/pairtools" },
                mode: params.publish_dir_mode,
                pattern: '*.dedup.stats'
            ]
        ]
    }

    withName: 'JUICER_PRE' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/CONTACTS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BIGWIG_COVERAGE' {
        // every read end of every unique contact, extended to a fragment
        ext.prefix = { "${meta.id}.CPM" }
        ext.args   = { "--normalizeUsing CPM --binSize 10 --extendReads ${params.hichip_extsize}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/COVERAGE_files" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MACS3_NARROW' {
        // read ends are single 1-bp records: BAM mode, fixed fragment length, read length given
        ext.format = 'BAM'
        ext.args   = {
            "--qvalue ${params.macs_qvalue ?: 0.01} --nomodel --extsize ${params.hichip_extsize} --tsize ${params.read_length}"
        }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BROWSER_PEAKS_NARROW' {
        ext.prefix = { "${meta.id}_peaks" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FRIP' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FITHICHIP' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/LOOPS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HICHIP_QC_REPORT' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ---------------------------------------------------------------- per run
    withName: 'HICHIP_QC_SUMMARY' {
        ext.prefix = 'hichip_qc_summary'
        ext.args   = "--title 'HiChIP' --section-id peddep_hichip_grades --thresholds-name hichip_qc_thresholds.json"
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('_mqc.html')) ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
