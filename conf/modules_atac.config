/*
========================================================================================
    ATAC-seq: tool arguments (ext.args / ext.prefix) and output locations.

    Per-sample results go to the samplesheet's `outdir` column when set, otherwise
    to <--outdir>/<sample>. Run-level results always go to <--outdir>.
========================================================================================
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        enabled: false
    ]

    // ---------------------------------------------------------------- reference
    withName: 'GUNZIP_.*|SAMTOOLS_FAIDX|BOWTIE2_BUILD|GENOME_FILTER|GTF2TSS|GENOME_SIZE' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    // ---------------------------------------------------------------- per lane
    withName: 'FASTQC_RAW' {
        ext.prefix = { "${meta.id}_L${meta.lane}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/FastQC/raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TRIMGALORE' {
        ext.prefix = { "${meta.id}_L${meta.lane}" }
        ext.args   = {
            [
                "--length ${params.min_trim_length}",
                params.adapter ? "--adapter ${params.adapter} --adapter2 ${params.adapter}" : '',
                '--fastqc'
            ].join(' ').trim()
        }
        publishDir = [
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/trim_report" },
                mode: params.publish_dir_mode,
                pattern: '*_trimming_report.txt'
            ],
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/FastQC/trimmed" },
                mode: params.publish_dir_mode,
                pattern: '*_fastqc.{zip,html}'
            ],
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/trimmed_fastq" },
                mode: params.publish_dir_mode,
                pattern: '*.fq.gz',
                enabled: params.save_trimmed
            ]
        ]
    }

    withName: 'BOWTIE2_ALIGN' {
        ext.prefix = { "${meta.id}_L${meta.lane}" }
        ext.args   = { "--very-sensitive --no-mixed --no-discordant -X ${params.max_fragment_length}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.bowtie2.log'
        ]
    }

    // ---------------------------------------------------------------- per sample
    withName: 'PICARD_MARKDUPLICATES' {
        publishDir = [
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/duplicates" },
                mode: params.publish_dir_mode,
                pattern: '*.metrics.txt'
            ],
            [
                path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/BAM_files" },
                mode: params.publish_dir_mode,
                pattern: '*.markdup.bam*',
                enabled: params.save_markdup_bam
            ]
        ]
    }

    withName: 'SAMTOOLS_STATS_MARKDUP' {
        ext.prefix = { "${meta.id}.markdup" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_STATS_FILTERED' {
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LIBRARY_COMPLEXITY' {
        ext.args   = { "--min-mapq ${params.min_mapq}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/library_complexity" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BAM_FILTER' {
        // 2828 = unmapped, mate unmapped, secondary, QC-fail, supplementary; +1024 = duplicates
        ext.args   = { "-f 2 -F ${params.keep_dups ? 2828 : 3852} -q ${params.min_mapq}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/BAM_files" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TN5_SHIFT' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/BAM_files" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_tn5_bam
        ]
    }

    withName: 'MACS3_NARROW' {
        ext.args   = { "--qvalue ${params.macs_qvalue} --call-summits" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS/NARROW_peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MACS3_BROAD' {
        ext.args   = { "--broad --broad-cutoff ${params.macs_broad_cutoff}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/PEAKS/BROAD_peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FRIP' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/peaks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BIGWIG_FRAGMENTS' {
        // one count per fragment (read 1 extended to the mate), CPM-normalised
        ext.prefix = { "${meta.id}.fragments.CPM" }
        ext.args   = '--normalizeUsing CPM --binSize 10 --extendReads --samFlagInclude 64'
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/COVERAGE_files" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BIGWIG_INSERTIONS' {
        // 1-bp Tn5 insertion sites from the shifted BAM, CPM-normalised
        ext.prefix = { "${meta.id}.tn5_insertions.CPM" }
        ext.args   = '--normalizeUsing CPM --binSize 1 --Offset 1'
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/COVERAGE_files" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPTOOLS_TSS_PLOTS' {
        ext.args   = { "--beforeRegionStartLength ${params.tss_window} --afterRegionStartLength ${params.tss_window} --binSize 10" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/TSS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPTOOLS_FINGERPRINT' {
        ext.args   = { "--numberOfSamples ${params.fingerprint_bins}" }
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/fingerprint" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FRAGMENT_QC' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/Fragments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ATAQV' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}/QC/ataqv" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ATAC_QC_REPORT' {
        publishDir = [
            path: { "${meta.outdir ?: params.outdir + '/' + meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ---------------------------------------------------------------- per run
    withName: 'MKARV' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ATAC_QC_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('_mqc.html')) ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
