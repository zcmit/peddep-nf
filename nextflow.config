/*
========================================================================================
    zcmit/peddep-nf  —  portable Nextflow pipelines for PEDDEP epigenomic assays
========================================================================================
    Site-neutral by design: nothing here assumes a particular cluster, scheduler or
    file system. Pick a container engine with -profile, and a scheduler with an
    nf-core institutional profile (e.g. -profile stjude) or your own -c config.
----------------------------------------------------------------------------------------
*/

params {
    // Pipeline selection & I/O
    assay                      = 'atac'
    input                      = null
    outdir                     = null
    publish_dir_mode           = 'copy'
    help                       = false

    // Reference genome: either --genome <key in conf/genomes.config> or explicit files
    genome                     = null
    fasta                      = null
    gtf                        = null
    blacklist                  = null
    bowtie2_index              = null
    mito_name                  = null
    macs_gsize                 = null
    canonical_chroms           = null
    sex_chroms                 = 'chrX,chrY,X,Y,chrZ,chrW,Z,W'
    save_reference             = false

    // Trimming
    adapter                    = null   // ATAC default: Nextera CTGTCTCTTATACACATCT; ChIP/CUT&RUN: auto-detect
    min_trim_length            = 20
    save_trimmed               = false

    // Alignment & read filtering
    max_fragment_length        = 2000
    min_mapq                   = 30
    keep_mito                  = false
    keep_dups                  = false

    // Peak calling (macs_qvalue default: ATAC 0.01, ChIP/CUT&RUN 0.05 as in pyflow-ChIPseq)
    macs_qvalue                = null
    macs_broad_cutoff          = 0.1
    skip_broad_peaks           = false

    // ChIP-seq / CUT&RUN
    broad_marks                = 'H3K27me3,H3K36me3,H3K9me3,H3K9me2,H3K79me2,H3K4me1,H4K20me1'
    rose_marks                 = 'H3K27ac'
    rose_stitch                = 12500
    rose_tss                   = 2000
    se_fragment_length         = 200
    spp_max_reads              = 15000000
    cutrun_dedup_targets       = false

    // BAM outputs
    save_markdup_bam           = false
    save_tn5_bam               = true

    // QC
    qc_thresholds              = null   // default: assets/<assay>_qc_thresholds.json
    multiqc_config             = null   // default: assets/multiqc_config[_chip].yml
    multiqc_title              = null
    fingerprint_bins           = 500000
    tss_window                 = 3000

    // Resource ceilings (any single task is capped at these)
    max_cpus                   = 16
    max_memory                 = '128.GB'
    max_time                   = '240.h'

    // nf-core institutional profiles (https://github.com/nf-core/configs)
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_name        = null
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null

    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/genomes.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        apptainer.enabled       = false
    }
    arm64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    test      { includeConfig 'conf/test.config'      }
    test_chip { includeConfig 'conf/test_chip.config' }
    test_full { includeConfig 'conf/test_full.config' }
}

// Institutional profiles from nf-core/configs (skipped when offline)
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Default registries for the docker-style container names
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'
singularity.registry = 'quay.io'
apptainer.registry   = 'quay.io'

// Keep containers isolated from the host user's Python/R/Julia setup
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

process.shell = [
    "bash",
    "-C",         // no clobber
    "-e",         // exit on error
    "-u",         // unset variables are errors
    "-o",
    "pipefail"
]

nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'zcmit/peddep-nf'
    contributors    = [
        [
            name: 'zcmit',
            affiliation: '',
            github: '@zcmit',
            contribution: ['author', 'maintainer']
        ]
    ]
    homePage        = 'https://github.com/zcmit/peddep-nf'
    description     = 'Portable Nextflow pipelines for PEDDEP epigenomic assays (ATAC-seq first; ChIP/CUT&RUN and HiChIP planned)'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0'
}

includeConfig params.assay == 'atac' ? 'conf/modules_atac.config' : 'conf/modules_chip.config'
